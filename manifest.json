{
  "manifest_version": 2,
  "name": "My IP Flag",
  "version": "1.1",
  "author": "Shawn Lim <shawnux@gmail.com>",
  "developer": { "name": "Shawn Lim" },
  "description": "Shows the country flag of your current public IP in the toolbar. Hover for IP, country, city and age of the lookup.",
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "permissions": ["https://api.ipify.org/*", "https://ipwho.is/*", "https://proxycheck.io/*"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "browser_action": { "default_title": "Loading...", "default_icon": "icon.svg" },
  "browser_specific_settings": {
    "gecko": {
      "id": "my-ip-flag@shawnlim",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
